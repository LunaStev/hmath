# SPDX-License-Identifier: MPL-2.0
set(PACKAGE_VERSION "@VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
# SemVer allows compatible releases within one major; bindings check ABI epoch.
string(REGEX MATCH "^[0-9]+" _HMATH_VERSION_MAJOR "${PACKAGE_VERSION}")
if(PACKAGE_FIND_VERSION_MAJOR EQUAL _HMATH_VERSION_MAJOR
   AND NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
unset(_HMATH_VERSION_MAJOR)
if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
  set(PACKAGE_VERSION_EXACT TRUE)
endif()
